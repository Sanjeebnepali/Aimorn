# Copy this to .env and fill in your real Clerk publishable key. Never
# commit .env — see .gitignore.
#
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time
# (Expo's own convention, see https://docs.expo.dev/guides/environment-variables/),
# which is fine here since a publishable key is meant to ship in client code —
# it authenticates the app to Clerk, not a user. It must come from the SAME
# Clerk application instance as CLERK_SECRET_KEY in server/.env, since the
# server verifies session tokens this key's Clerk instance issues.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Base URL of amora/server (see server/.env.example). Onboarding's code
# generation/pairing calls are the first things in this app that need it —
# use your machine's LAN IP (not localhost) so a physical device on the same
# WiFi can reach it, e.g. "http://192.168.0.18:4000". Requests to it fail
# gracefully (not a hard crash) until the server has a real DATABASE_URL.
EXPO_PUBLIC_API_URL="http://192.168.0.18:4000"
