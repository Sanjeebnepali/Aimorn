# Copy this to .env and fill in your real Clerk publishable key. Never
# commit .env — see .gitignore.
#
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time
# (Expo's own convention, see https://docs.expo.dev/guides/environment-variables/),
# which is fine here since a publishable key is meant to ship in client code —
# it authenticates the app to Clerk, not a user. It must come from the SAME
# Clerk application instance as CLERK_SECRET_KEY in server/.env, since the
# server verifies session tokens this key's Clerk instance issues.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Base URL of amora/server (see server/.env.example). Onboarding's code
# generation/pairing calls are the first things in this app that need it —
# use your machine's LAN IP (not localhost) so a physical device on the same
# WiFi can reach it, e.g. "http://192.168.0.18:4000". Requests to it fail
# gracefully (not a hard crash) until the server has a real DATABASE_URL.
EXPO_PUBLIC_API_URL="http://192.168.0.18:4000"

# RevenueCat's PUBLIC SDK keys (from the RevenueCat dashboard → API Keys —
# one per platform, both start "goog_"/"appl_" depending on store). Public
# the same way the Clerk key above is: they authenticate this app to
# RevenueCat, not a user, so shipping them in the client bundle is the
# intended use. Leave unset for a local/dev build with no store billing yet
# — src/iap/purchases.ts's configurePurchases() no-ops without them, and the
# paywall falls back to showing it can't load real pricing rather than
# crashing. Never confuse these with server/.env's REVENUECAT_SECRET_API_KEY
# — that one is secret and must never appear in client code.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY="appl_xxx"
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY="goog_xxx"

# AdMob ad unit ids (src/ads/adUnitIds.ts) — each falls back to Google's own
# official TEST ad unit id when unset, so a local/dev build always shows
# real (test) ad creatives with zero setup. Create real ones at
# apps.admob.com → Ad units. The App ID itself is NOT an env var — it's read
# from app.json at native build time (see that file's own comment).
EXPO_PUBLIC_ADMOB_REWARDED_UNIT_ID="ca-app-pub-xxx/xxx"
EXPO_PUBLIC_ADMOB_APP_OPEN_UNIT_ID="ca-app-pub-xxx/xxx"
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID="ca-app-pub-xxx/xxx"
EXPO_PUBLIC_ADMOB_NATIVE_UNIT_ID="ca-app-pub-xxx/xxx"
