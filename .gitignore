# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
# Real Android release-signing credentials (see keystore.properties's own
# doc comment) — *.jks above already covers the actual keystore file itself;
# this covers the passwords/alias sitting next to it at the project root.
keystore.properties
# Firebase's own per-environment Android config (real FCM/project identifiers
# for push notifications — see app.json's android.googleServicesFile and
# src/notifications/register.ts's own doc comment). Not a hard secret the
# way keystore.properties is, but still environment-specific and
# regeneratable from the Firebase console, so it doesn't belong in git.
google-services.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
# This session's own Metro/Gradle build logs (metro-boot*.log,
# android-build*.log) — pure local debugging noise from live device
# testing, never meant to be version-controlled.
*.log

# macOS
.DS_Store
*.pem

# local env files — .env holds the real Clerk publishable key (not secret,
# but still instance-specific config that shouldn't be forced on every clone)
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android
build/
android/build/
modules/*/android/build/
modules/*/build/
*.apk
*.dex

# Gradle's own local build cache/lock files — found 2026-09-11 tracked under
# modules/wallpaper-manager/android/.gradle/ (a real leftover from before this
# rule existed): pure machine-local state (binary lock files, timestamps),
# changes on every build, and was never meant to be version-controlled.
# `/android`'s own .gradle is already covered by the whole-folder `/android`
# rule above; this catches the same thing for any local Expo module's own
# android/ project (which isn't covered by that root-only rule).
modules/*/android/.gradle/
.gradle/
