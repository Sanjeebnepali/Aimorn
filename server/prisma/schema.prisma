// Standard Postgres via Prisma — this is deliberately host-agnostic. The
// same schema/migrations apply whether DATABASE_URL points at Neon (free,
// now) or AWS RDS (later); nothing here is Neon- or Render-specific.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Neon recommends migrations run over the unpooled connection (PgBouncer's
  // transaction pooling can't hold the advisory lock `migrate dev` needs).
  // Only consulted for migrate/db push — the app's runtime queries still go
  // through `url` above. A future non-Neon host (e.g. RDS) with no pooled/
  // unpooled split must still set DATABASE_URL_UNPOOLED (equal to
  // DATABASE_URL is fine) — Prisma requires the referenced env var to exist.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/// Mirrors a Clerk user. Clerk is the source of truth for identity/session —
/// this row exists so generations/credits have something in OUR database to
/// foreign-key against. Created on first authenticated request (see
/// src/middleware/auth.ts) rather than via a webhook, to avoid depending on
/// Clerk webhooks being reachable during early self-hosted testing.
model User {
  /// Clerk's user id (e.g. "user_2abc..."), used as-is — no separate id.
  id          String       @id
  email       String?      @unique
  displayName String?
  /// Starter balance so a new signup can try one generation immediately.
  credits     Int              @default(3)
  /// Earned separately from `credits` — see Post.pointsAwarded for how these
  /// accrue (100 regenerations of one of your posts = 1 point, see
  /// generations.ts's awardPointsForRegeneration). Kept as its own ledger
  /// rather than crediting `credits` directly so "earned from the
  /// community" and "purchased/starter balance" stay distinguishable in the
  /// UI and can't be silently conflated — POST /profile/redeem-points is the
  /// one place points convert into spendable credits, 1:1, on request.
  points      Int              @default(0)
  /// Subscription tier: FREE, PRO, or ULTRA
  subscriptionTier      SubscriptionTier @default(FREE)
  /// Expiration date for paid subscriptions (null for free users)
  subscriptionExpiresAt DateTime?
  /// Timestamp of when daily free credits (2 per day) were last granted
  lastDailyCreditReset  DateTime?
  /// Rewarded video ad view tracking
  adWatchesToday        Int              @default(0)
  lastAdWatchReset      DateTime?
  /// Progress toward unlocking the one-time 3-day free trial (see POST
  /// /profile/trial/watch-ad) — ads watched so far, out of TRIAL_ADS_REQUIRED.
  /// Only meaningful while `trialUsedAt` is null; not reset once the trial
  /// has been activated (that's what `trialUsedAt` guards against reuse).
  trialAdsWatched        Int              @default(0)
  /// Set once, the moment the trial activates — a lifetime one-shot, not a
  /// per-period flag, so it also blocks a second free trial after the first
  /// one expires. Null means "never activated, still eligible."
  trialUsedAt            DateTime?
  createdAt   DateTime         @default(now())
  generations Generation[]
  posts       Post[]

  /// Set once the post-signup onboarding flow (name/photo, style survey,
  /// personal + pairing codes) is completed — null gates the app's root
  /// layout into showing /onboarding instead of the main tabs. Deliberately
  /// a timestamp rather than a boolean so "when" is available for free if
  /// it's ever needed (funnel analytics, re-prompting after a long gap).
  onboardedAt     DateTime?
  /// A short, human-shareable handle ("Your Amora ID") distinct from the
  /// pairing code below — this one identifies the account itself and isn't
  /// consumed/invalidated by use, unlike a pairing code.
  username        String?      @unique
  /// S3/R2 object key for the onboarding profile photo. Named `avatarKey`
  /// (not `avatarUrl`) to match `photoAKey`/`outputKey` below — a stored
  /// object key the client resolves through the same publicUrlFor() as
  /// everything else in src/lib/storage.ts, not a pre-built URL.
  avatarKey       String?
  /// Matches a StyleOption.key from amora/src/components/primitives/style-swatch.tsx
  /// — the onboarding survey's taste question, doubles later as a default
  /// style suggestion on the Generate screen.
  stylePreference String?
  /// The onboarding survey's other question: does this person expect to use
  /// Amora solo or with a partner. Reuses SubjectMode rather than a new enum
  /// since it's the same solo/couple distinction Generation already tracks.
  usageMode       SubjectMode?
  /// One-time code this user generated to hand to a partner — cleared once
  /// consumed via POST /profile/pair so a code can't be reused by a third
  /// party after the intended partner has already redeemed it.
  pairingCode     String?      @unique
  /// The other half of a linked pair. Single-sided FK (not mirrored on both
  /// rows) is enough for a 1:1 relation — Prisma resolves the reverse
  /// direction through `partnerOf` below, and `@unique` guarantees no third
  /// user can also claim the same partner.
  partnerId       String?      @unique
  partner         User?        @relation("Partnership", fields: [partnerId], references: [id])
  partnerOf       User?        @relation("Partnership")

  /// Which wallpaper-pack slot this account renders when apart from its
  /// partner (see Couple.packId / constants in src/couple/packs.ts). Set via
  /// PATCH /couple/role, once per couple per slot — see couple.ts route for
  /// the "first pick creates the Couple row, second pick joins it" logic.
  coupleRole CoupleRole?
  coupleId   String?
  couple     Couple?         @relation(fields: [coupleId], references: [id])
  /// Live GPS for the proximity check — one row per user, not per couple, so
  /// each side writes only its own row (see POST /couple/location).
  location   CoupleLocation?

  /// This device's raw FCM registration token (Android) or APNs token
  /// (iOS) — see expo-notifications' getDevicePushTokenAsync(), NOT an Expo
  /// push token: this project has no EAS project linked (builds are local,
  /// see AGENTS.md/workspace notes), so sending goes straight through
  /// Firebase Cloud Messaging from server/src/lib/push.ts rather than
  /// through Expo's own hosted push relay, which needs an EAS projectId
  /// this app doesn't have. One token per user (not per device) is a
  /// deliberate simplification — a user signed in on two devices only gets
  /// pushes on whichever signed in most recently, acceptable for a V1 with
  /// no multi-device push fan-out yet. Null until the app has actually
  /// requested permission and registered one (see POST /profile/push-token).
  pushToken             String?
  /// Master on/off switch for this account's push notifications — a real,
  /// user-controlled preference (Profile → Notifications), not just a
  /// device-permission check, so a signed-in user can mute pushes without
  /// revoking OS-level notification permission entirely. Every server-side
  /// send site (see push.ts's sendPushToUser) must check this before
  /// sending, not just whether pushToken is set.
  notificationsEnabled  Boolean @default(true)
  /// When this account last opened the in-app Notification History screen
  /// — a Notification (below) is "unread" purely by comparing its
  /// createdAt against this timestamp, not a per-row read flag. Cheap and
  /// correct for a single linear feed: a per-Notification read table would
  /// only matter if unread state could be marked per-item, which this V1
  /// deliberately doesn't do (see notifications.tsx's own doc comment).
  /// Null means "never opened it" — every notification is unread.
  notificationsViewedAt DateTime?
  notifications         Notification[]
}

enum NotificationScope {
  /// Sent to exactly one user (userId set) — partner-paired, etc. See
  /// lib/push.ts's sendPushToUser.
  PERSONAL
  /// Sent to every opted-in user at once (userId null) — one row covers
  /// the whole audience rather than fanning out a write per recipient,
  /// which wouldn't scale and isn't needed since a broadcast's content is
  /// identical for everyone. See lib/push.ts's sendBroadcastNotification.
  BROADCAST
}

/// The in-app Notification History record of every push actually sent —
/// independent of whether the OS notification tray still shows it (that's
/// ephemeral and platform-controlled; this is the durable, in-app list a
/// user can scroll back through). Written by lib/push.ts at the same
/// moment the real FCM send happens, never on its own — there's no
/// "notification" here that wasn't actually pushed.
model Notification {
  id        String             @id @default(cuid())
  scope     NotificationScope
  /// Set for PERSONAL, null for BROADCAST — see NotificationScope's own
  /// doc comment for why a broadcast doesn't get one row per recipient.
  userId    String?
  user      User?              @relation(fields: [userId], references: [id])
  title     String
  body      String
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([scope, createdAt])
}

/// One row per RevenueCat purchase transaction ever actually credited —
/// the idempotency guard for the RevenueCat integration (see
/// src/lib/revenueCat.ts's applyPurchase, the one place that both the
/// webhook route AND the client-triggered /iap/sync route funnel through).
/// RevenueCat can and does redeliver the same webhook event more than once
/// (their own docs say so), and a purchase can ALSO reach us twice through
/// two different paths — the webhook and the client's own immediate sync
/// call right after `Purchases.purchasePackage()` resolves — without this,
/// either path alone risks double-granting credits for one real purchase.
/// `transactionId` is RevenueCat's own per-purchase id (unique per renewal
/// too, so a subscription's 2nd/3rd period each get their own row and their
/// own credit grant, exactly once).
model ProcessedPurchase {
  id             String   @id @default(cuid())
  transactionId  String   @unique
  userId         String
  productId      String
  creditsGranted Int
  createdAt      DateTime @default(now())
}

enum CoupleRole {
  A
  B
}

enum SubscriptionTier {
  FREE
  /// The one-time, ad-unlocked 3-day trial (POST /profile/trial/watch-ad) —
  /// deliberately its own value rather than reusing PRO, so the client can
  /// show "Trial" instead of "Pro" and so a lapsed trial is distinguishable
  /// from a lapsed real subscription in analytics later. Every place that
  /// checks `subscriptionTier !== 'FREE'` (isSubscribed, in generations.ts
  /// and profile.ts) already treats TRIAL as a real, bounded subscription —
  /// same credit cap, same expiry check, no special-casing needed.
  TRIAL
  PRO
  ULTRA
}

/// Shared state for one linked pair's proximity-wallpaper feature. Deliberately
/// separate from the User.partnerId relation above (which only says "these two
/// accounts are linked") — a couple can be linked for months before ever
/// turning proximity wallpapers on, so this row is created lazily, the first
/// time either side picks a role (see PATCH /couple/role), not at pairing time.
model Couple {
  id         String   @id @default(cuid())
  /// Matches a CouplePack.id from src/couple/packs.ts (one of the 3 bundled
  /// packs) OR a Generation.id when the active pack is a real AI-generated
  /// couple session — see customPack* below for why that second case needs
  /// its own fields rather than just resolving packId as a Generation id
  /// on demand.
  packId     String?
  /// The three resolved public R2 URLs for a custom (AI-generated) active
  /// pack, copied here ONCE when either partner picks one (PATCH
  /// /couple/settings) — not fetched live from the Generation each time,
  /// because GET /generations/:id is scoped to its owner (privacy-correct
  /// for a personal creation), so the OTHER partner has no way to resolve
  /// it by id alone. Copying the already-public URLs onto this shared row
  /// sidesteps that: both partners already read this same Couple row via
  /// their own GET /couple, no cross-account fetch needed. All three null
  /// together means "packId (if any) refers to a bundled pack instead."
  customPackTogetherUrl String?
  customPackAUrl        String?
  customPackBUrl        String?
  /// When true, proximity always reads 'far' — see server/src/routes/couple.ts
  /// GET handler and the client's recomputeDistance, which both need to honor
  /// this independently (server for the partner-location read, client for its
  /// own store's proximity calc).
  paused     Boolean  @default(false)
  thresholdM Int      @default(100)
  createdAt  DateTime @default(now())
  members    User[]
}

/// One row per user — NOT per couple — because each side only ever writes its
/// own position; the other side's row is read via their User.partnerId.
model CoupleLocation {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  accuracyM Float?
  updatedAt DateTime @updatedAt
}

enum SubjectMode {
  SOLO
  COUPLE
  /// A real group photo — 2 to 4 DISTINCT people fused into one scene
  /// together, added 2026-09-12 for a real request: "three faces in one
  /// photo... exactly." Deliberately reuses photoAKey/photoAExtraKeys as
  /// storage (person 1 → photoAKey, the rest → photoAExtraKeys) rather than
  /// new columns — that pair already means "an array of photos attached to
  /// this generation," and GROUP is simply the one subjectMode where each
  /// entry is a DIFFERENT person's own single photo instead of one
  /// person's multiple angles. See server's promptBuilder.ts
  /// buildGroupScenePrompt for how the prompt text tells the model these
  /// are DISTINCT individuals — the opposite instruction from what the
  /// same array means for SOLO/COUPLE's multi-angle identity lock.
  GROUP
}

enum GenerationStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

/// One "fuse these photo(s) into this theme+style" job. Deliberately carries
/// `provider`/`model` per row (not a global config) so we can A/B different
/// AI providers per generation later without a schema change — same idea
/// this app's design docs flagged as useful when comparing providers.
model Generation {
  id          String            @id @default(cuid())
  user        User              @relation(fields: [userId], references: [id])
  userId      String
  /// Matches a Template.id from amora/src/data/templates.ts, when the user
  /// started from a template rather than a freeform prompt.
  templateId  String?
  /// Matches a StyleOption.key from style-swatch.tsx (e.g. "realistic").
  styleKey    String
  subjectMode SubjectMode
  description String?
  /// S3/R2 object key for the "You" photo — always the FIRST of possibly
  /// several reference angles of that person (photoAExtraKeys holds any
  /// more). Kept as the single source every other feature already reads
  /// (thumbnails, the DELETE route's R2 cleanup, points.ts, posts.ts) so
  /// none of that has to learn about multi-angle uploads.
  photoAKey   String
  /// S3/R2 object key for the "Partner" photo — null when subjectMode=SOLO.
  /// Same "first of possibly several" relationship to photoBExtraKeys.
  photoBKey   String?
  /// Any reference angles of the "You" person BEYOND photoAKey — added
  /// 2026-09-12 for multi-angle identity lock (server/src/lib/promptBuilder.ts's
  /// PromptInput.photoACount doc comment has the research this is built
  /// against: several angles of one person measurably improve identity-lock
  /// over a single photo). Empty array, not null, when there are none —
  /// simpler for every consumer (`...generation.photoAExtraKeys` spreads
  /// safely either way) than an optional array would be.
  photoAExtraKeys String[] @default([])
  /// Same idea as photoAExtraKeys, for the "Partner" person.
  photoBExtraKeys String[] @default([])
  provider    String
  model       String
  status      GenerationStatus  @default(PENDING)
  /// S3/R2 object key of the result image, set only once status=COMPLETE.
  /// For subjectMode=COUPLE this is the "together" shot; SOLO has only this.
  outputKey   String?
  /// Solo portrait of the "You" photo, same theme/style/seed as outputKey —
  /// only ever set for subjectMode=COUPLE (see generations.ts's 3-image
  /// session). Null for SOLO, where there's no second identity to split out.
  outputKeyA  String?
  /// Solo portrait of the "Partner" photo — see outputKeyA.
  outputKeyB  String?
  /// Shared across all images in one session (1 for SOLO, 3 for COUPLE) so
  /// the together/solo-A/solo-B shots share lighting/color grade instead of
  /// each landing as an unrelated roll of the dice — see qwenImageEdit.ts.
  seed        Int?
  errorMessage String?
  creditCost  Int               @default(1)
  /// Set when this generation was created via a post's "Recreate" button
  /// rather than from scratch — see generations.ts's POST /generations.
  /// Drives Post.regenerationCount/pointsAwarded (that post's owner earns
  /// points as their post gets recreated by others), completely separate
  /// from `templateId` above (a bundled starter theme) since a post being
  /// recreated already carries its own templateId/styleKey from its source
  /// generation — this just additionally credits whoever posted it.
  sourcePost   Post?             @relation("RegeneratedFrom", fields: [sourcePostId], references: [id])
  sourcePostId String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  post        Post?

  @@index([userId, createdAt])
  @@index([sourcePostId])
}

/// A user sharing one of their own COMPLETE generations to the public
/// community feed (Home's "Recent Post"/"Trending Creations" — see
/// src/app/(tabs)/index.tsx). Deliberately references `Generation` rather
/// than copying its output keys/style/theme onto this row: those never
/// change after COMPLETE, so joining avoids two rows drifting out of sync,
/// and this table only needs to own what's actually post-specific (caption,
/// regeneration/points bookkeeping).
model Post {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  /// One post per generation — sharing the same creation twice would just
  /// double-count its regenerations/points for no real benefit, and the
  /// client's Share flow (create-post) always starts from a specific one of
  /// your own Gallery items.
  generation   Generation @relation(fields: [generationId], references: [id])
  generationId String     @unique

  /// Short one-line title, separate from `caption` below — mirrors
  /// src/app/create-post's own title+description split (its own comment
  /// there explains why: an explicit ask to diverge from a strict
  /// Instagram/TikTok single-caption model).
  title   String?
  caption String?

  /// How many times another user has tapped "Recreate" on this post (see
  /// generations.ts's POST /generations with `sourcePostId`) — the trending
  /// rank (GET /posts/trending, top 5 by this field) and the points economy
  /// both key off this one counter.
  regenerationCount Int @default(0)
  /// How many times this post's detail screen (src/app/post/[id].tsx) has
  /// been opened — incremented by POST /posts/:id/view. Simple lifetime
  /// counter, not deduplicated per viewer (same "every open counts" model
  /// as a YouTube view), pushed live to anyone currently watching this post
  /// via realtime/postsSocket.ts.
  viewCount Int @default(0)
  /// Cumulative points already paid out to `userId` for this post, i.e.
  /// `floor(regenerationCount / 100)` the last time it was checked — stored
  /// so awarding is idempotent (each regeneration only pays the NEW
  /// points crossed, never re-pays ones already granted) without needing a
  /// separate ledger/audit table for what's a single simple counter.
  pointsAwarded Int @default(0)

  /// The generations created by recreating THIS post — see Generation.
  /// sourcePostId. Named for the inverse relation, not queried directly
  /// anywhere yet (regenerationCount is the maintained, cheap-to-read
  /// counter for that), but kept so the relation is real or Prisma can't
  /// express Generation.sourcePost's side of it.
  regenerations Generation[] @relation("RegeneratedFrom")

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([regenerationCount])
}
