{
  "name": "amora-server",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Amora backend API — self-hosted, portable between free hosting and AWS/other clouds.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-template-images.mjs",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "prisma:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "dev:neon-branch": "neon-env run -- node ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start:neon-branch": "neon-env run -- node dist/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clerk/backend": "^2.33.6",
    "@clerk/express": "^1.4.0",
    "@google/genai": "^1.0.0",
    "@huggingface/inference": "^4.13.28",
    "@neon/config": "^1.3.0",
    "@neon/env": "^1.2.1",
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "prisma": "^6.1.0",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
