# Copy this to .env and fill in real values. Never commit .env.
#
# Every value below is chosen so the SAME code runs unmodified on a free host
# today and on AWS (or any other cloud) later — only these values change,
# never the code that reads them. See README.md "Moving to AWS later" section.

PORT=4000

# --- Database (Postgres) ---------------------------------------------------
# Free now: a Neon (neon.tech) free-tier connection string — permanent free
# Postgres, no credit card, no expiry.
# Later on AWS: an RDS Postgres connection string. Same DATABASE_URL shape
# either way (standard `postgresql://user:pass@host:port/db`), so Prisma and
# every query in this app work unchanged.
DATABASE_URL="postgresql://user:password@host:5432/amora?sslmode=require"

# --- Auth (Clerk) ------------------------------------------------------------
# From your Clerk dashboard (clerk.com). Free tier: 50,000 monthly retained
# users. Clerk itself is a hosted auth service, not tied to where THIS server
# runs — no change needed when this server moves hosts.
CLERK_SECRET_KEY="sk_test_xxx"
CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# --- Object storage (photos + generated images) -----------------------------
# Free now: Cloudflare R2 (10GB free forever, S3-compatible API).
# Later on AWS: swap these four values for real AWS S3 + IAM credentials and
# delete S3_ENDPOINT (AWS S3 doesn't need a custom endpoint) — the storage
# code itself (src/lib/storage.ts) uses the standard AWS SDK and does not
# change, because R2 speaks the same S3 API.
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_BUCKET="amora-media"
S3_ACCESS_KEY_ID="xxx"
S3_SECRET_ACCESS_KEY="xxx"
# Public base URL to read objects back from (R2 public bucket URL or a custom
# domain now; the S3/CloudFront URL later).
S3_PUBLIC_BASE_URL="https://media.example.com"

# --- AI provider (Hugging Face Inference Providers / Qwen-Image-Edit) ------
# The provider actually in use — real, verified two-person fusion test run
# (see docs/ai-generation-plan.md §3a), near-free. Get a free token at
# huggingface.co/settings/tokens — type "Fine-grained", scope: only
# "Make calls to Inference Providers". Starts with "hf_".
HF_TOKEN="hf_xxx"
# Swappable without touching code — see src/lib/ai/qwenImageEdit.ts.
HF_QWEN_MODEL="Qwen/Qwen-Image-Edit-2511"

# --- AI provider (Google Gemini / "Nano Banana") — optional, not required --
# A real future option (docs/ai-generation-plan.md §3), but untested and
# blocked on Google Cloud billing setup — leave unset unless you're
# specifically testing it. Free to obtain a key at aistudio.google.com.
GEMINI_API_KEY="xxx"
# Swappable without touching code — see src/lib/ai/nanoBanana.ts.
GEMINI_MODEL="gemini-2.5-flash-image"

# --- RevenueCat (real App Store / Play Store billing) ----------------------
# Both optional — see src/lib/revenueCat.ts's isRevenueCatConfigured(). The
# app runs fine with neither set; POST /webhooks/revenuecat and /iap/sync
# just answer 503 until they are. See src/lib/creditsConfig.ts's
# REVENUECAT_PRODUCT_MAP for the exact product/entitlement identifiers this
# code expects you to have created in the RevenueCat dashboard, App Store
# Connect, and Google Play Console.
#
# Secret key from RevenueCat's dashboard → API Keys (starts "sk_"). Server-
# side only — never the client's public SDK key (that one belongs in the
# CLIENT's .env as EXPO_PUBLIC_REVENUECAT_*_API_KEY, see .env.example there).
REVENUECAT_SECRET_API_KEY="sk_xxx"
# Whatever string you set as this webhook's "Authorization header value" in
# RevenueCat's dashboard → Project Settings → Webhooks (any long random
# string you generate yourself — RevenueCat just echoes it back verbatim on
# every event so this server can verify the request actually came from
# RevenueCat, not an outsider who found the webhook URL).
REVENUECAT_WEBHOOK_AUTHORIZATION="xxx"
